{
  "name": "@mini-roda/customers-service",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "uvicorn app.main:app --reload --host 0.0.0.0 --port 8001",
    "build": "echo 'Python service - no build step required'",
    "lint": "ruff check . && mypy .",
    "format": "ruff format .",
    "clean": "rm -rf __pycache__ *.egg-info .mypy_cache .ruff_cache",
    "test": "pytest tests/ -v --cov=app --cov-report=term-missing",
    "migrate": "alembic upgrade head",
    "migrate-create": "alembic revision --autogenerate -m",
    "migrate-downgrade": "alembic downgrade -1"
  }
}

